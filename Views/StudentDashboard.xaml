<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTE_Parking_Project.Views.StudentDashboard"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#1a1f8a">

    <Grid RowDefinitions="Auto, *, Auto">

        <Grid Grid.Row="0">
            <BoxView>
                <BoxView.Background>
                    <RadialGradientBrush Center="0.5,0.1" Radius="0.7">
                        <GradientStop Color="#5868f0" Offset="0.0"/>
                        <GradientStop Color="#3B47D9" Offset="0.4"/>
                        <GradientStop Color="#2832c4" Offset="0.7"/>
                        <GradientStop Color="#1a1f8a" Offset="1.0"/>
                    </RadialGradientBrush>
                </BoxView.Background>
            </BoxView>

            <VerticalStackLayout Padding="16,36,16,0" Spacing="8">

                <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="10">

                    <Border Grid.Column="0"
                            BackgroundColor="#FFD700" StrokeThickness="0"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Start" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#FFD700" Opacity="0.4" Radius="10" Offset="0,3"/>
                        </Border.Shadow>
                        <AbsoluteLayout WidthRequest="34" HeightRequest="30"
                                        HorizontalOptions="Center" VerticalOptions="Center">
                            <Ellipse AbsoluteLayout.LayoutBounds="0,11,12,12" Stroke="White" StrokeThickness="1.8" Fill="Transparent"/>
                            <Ellipse AbsoluteLayout.LayoutBounds="20,11,12,12" Stroke="White" StrokeThickness="1.8" Fill="Transparent"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="6"  Y1="17" X2="13" Y2="6"  Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="13" Y1="6"  X2="13" Y2="12" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="13" Y1="12" X2="6"  Y2="17" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="13" Y1="6"  X2="26" Y2="12" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="13" Y1="12" X2="26" Y2="17" Stroke="White" StrokeThickness="1.6" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="26" Y1="9"  X2="26" Y2="17" Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="24" Y1="9"  X2="29" Y2="9"  Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="13" Y1="6"  X2="11" Y2="3"  Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"/>
                            <Line AbsoluteLayout.LayoutBounds="0,0,34,30" X1="9"  Y1="2.5" X2="14" Y2="2.5" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"/>
                            <Ellipse AbsoluteLayout.LayoutBounds="22,0,5,5" Fill="White"/>
                        </AbsoluteLayout>
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Xin chào," TextColor="#ffffff88" FontSize="11"/>
                        <Label x:Name="lblTenTab1" Text="" TextColor="White"
                               FontSize="15" FontAttributes="Bold"/>
                        <Label x:Name="lblMssvHeader" Text="" TextColor="#93C5FD" FontSize="11"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center"
                            BackgroundColor="#1AFFFFFF" Stroke="#33FFFFFF" StrokeThickness="1" Padding="12,6">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                            <Label x:Name="lblClock" Text="00:00:00"
                                   TextColor="#4AE8A0" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1"/>
                            <Label x:Name="lblDate" Text=""
                                   TextColor="#BAE6FD" FontSize="9" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <BoxView HeightRequest="1" BackgroundColor="#33ffffff" Margin="0,4,0,0"/>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4" Margin="0,0,0,0">

                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                        <Border x:Name="hTabBg0" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="46" HeightRequest="32" HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <AbsoluteLayout x:Name="hIconTab0" WidthRequest="26" HeightRequest="22"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                <Ellipse AbsoluteLayout.LayoutBounds="0,8,9,9" Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse AbsoluteLayout.LayoutBounds="15,8,9,9" Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="4"  Y1="12" X2="10" Y2="4"  Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="10" Y1="4"  X2="10" Y2="9"  Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="10" Y1="9"  X2="4"  Y2="12" Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="10" Y1="4"  X2="20" Y2="9"  Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="10" Y1="9"  X2="20" Y2="12" Stroke="White" StrokeThickness="1.4" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="20" Y1="6"  X2="20" Y2="12" Stroke="White" StrokeThickness="1.3" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="18" Y1="6"  X2="22" Y2="6"  Stroke="White" StrokeThickness="1.3" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="10" Y1="4"  X2="8"  Y2="2"  Stroke="White" StrokeThickness="1.3" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,26,22" X1="6.5" Y1="1.5" X2="10" Y2="1.5" Stroke="White" StrokeThickness="1.5" StrokeLineCap="Round"/>
                                <Ellipse AbsoluteLayout.LayoutBounds="17,0,4,4" Fill="White"/>
                            </AbsoluteLayout>
                        </Border>
                        <Label x:Name="hTextTab0" Text="Gửi xe" FontSize="10" FontAttributes="Bold"
                               TextColor="White" HorizontalOptions="Center"/>
                        <BoxView x:Name="hTabLine0" HeightRequest="2" WidthRequest="28"
                                 Color="White" CornerRadius="1" HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab0Clicked"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                        <Border x:Name="hTabBg1" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="46" HeightRequest="32" HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid x:Name="hIconTab1" WidthRequest="24" HeightRequest="16"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Border BackgroundColor="Transparent" Stroke="#88ffffff"
                                        StrokeThickness="1.5" WidthRequest="24" HeightRequest="15">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                                </Border>
                                <BoxView Color="#88ffffff" WidthRequest="1.5" HeightRequest="9"
                                         HorizontalOptions="Start" VerticalOptions="Center" Margin="6,0,0,0"/>
                                <BoxView Color="#88ffffff" WidthRequest="7" HeightRequest="1.5"
                                         HorizontalOptions="Center" VerticalOptions="Center" Margin="4,0,0,0"/>
                            </Grid>
                        </Border>
                        <Label x:Name="hTextTab1" Text="Vé xe" FontSize="10" FontAttributes="Bold"
                               TextColor="#93C5FD" HorizontalOptions="Center"/>
                        <BoxView x:Name="hTabLine1" HeightRequest="2" WidthRequest="28"
                                 Color="Transparent" CornerRadius="1" HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab1Clicked"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                        <Border x:Name="hTabBg2" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="46" HeightRequest="32" HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid x:Name="hIconTab2" WidthRequest="20" HeightRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Ellipse WidthRequest="18" HeightRequest="18"
                                         Stroke="#88ffffff" StrokeThickness="1.5" Fill="Transparent"
                                         HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Line X1="9" Y1="9" X2="9" Y2="5"
                                      Stroke="#88ffffff" StrokeThickness="1.5" StrokeLineCap="Round"
                                      AbsoluteLayout.LayoutBounds="0,0,20,20"/>
                                <Line X1="9" Y1="9" X2="13" Y2="12"
                                      Stroke="#88ffffff" StrokeThickness="1.5" StrokeLineCap="Round"
                                      AbsoluteLayout.LayoutBounds="0,0,20,20"/>
                            </Grid>
                        </Border>
                        <Label x:Name="hTextTab2" Text="Lịch sử" FontSize="10" FontAttributes="Bold"
                               TextColor="#93C5FD" HorizontalOptions="Center"/>
                        <BoxView x:Name="hTabLine2" HeightRequest="2" WidthRequest="28"
                                 Color="Transparent" CornerRadius="1" HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab2Clicked"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                        <Border x:Name="hTabBg3" BackgroundColor="Transparent" StrokeThickness="0"
                                WidthRequest="46" HeightRequest="32" HorizontalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid x:Name="hIconTab3" WidthRequest="18" HeightRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center">
                                <Ellipse WidthRequest="8" HeightRequest="8"
                                         Stroke="#88ffffff" StrokeThickness="1.5" Fill="Transparent"
                                         HorizontalOptions="Center" VerticalOptions="Start" Margin="0,1,0,0"/>
                                <Path Data="M1,19 C1,14 3,12 9,12 C15,12 17,14 17,19"
                                      Stroke="#88ffffff" StrokeThickness="1.5" StrokeLineCap="Round"
                                      Fill="Transparent" HorizontalOptions="Center" VerticalOptions="End"/>
                            </Grid>
                        </Border>
                        <Label x:Name="hTextTab3" Text="Hồ sơ" FontSize="10" FontAttributes="Bold"
                               TextColor="#93C5FD" HorizontalOptions="Center"/>
                        <BoxView x:Name="hTabLine3" HeightRequest="2" WidthRequest="28"
                                 Color="Transparent" CornerRadius="1" HorizontalOptions="Center"/>
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab3Clicked"/>
                        </VerticalStackLayout.GestureRecognizers>
                    </VerticalStackLayout>

                </Grid>
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1" BackgroundColor="Transparent"
                    VerticalScrollBarVisibility="Never">
            <Border StrokeThickness="0" Padding="16,16,16,40"
                    BackgroundColor="#F5F7FF" MinimumHeightRequest="900">
                <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="0">

                    <VerticalStackLayout x:Name="Tab0" IsVisible="True" Spacing="16">

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,0,0,4">
                            <Border Grid.Column="0" StrokeThickness="1.5" Stroke="#A7F3D0" Padding="0,14" BackgroundColor="White">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#10B981" Opacity="0.15" Radius="10" Offset="0,5"/></Border.Shadow>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Border BackgroundColor="#10B981" StrokeThickness="0" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Label Text="P" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <Label x:Name="lblStatFree" Text="124" TextColor="#059669" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Chỗ trống" TextColor="#64748B" FontSize="11" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" StrokeThickness="1.5" Stroke="#FDE68A" Padding="0,14" BackgroundColor="White">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#F59E0B" Opacity="0.15" Radius="10" Offset="0,5"/></Border.Shadow>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <AbsoluteLayout WidthRequest="26" HeightRequest="20" HorizontalOptions="Center" Margin="0,3,0,3">
                                        <BoxView AbsoluteLayout.LayoutBounds="0,14,5,6"  Color="#F59E0B" CornerRadius="1.5"/>
                                        <BoxView AbsoluteLayout.LayoutBounds="7,8,5,12"  Color="#F59E0B" CornerRadius="1.5"/>
                                        <BoxView AbsoluteLayout.LayoutBounds="14,2,5,18" Color="#F59E0B" CornerRadius="1.5"/>
                                        <BoxView AbsoluteLayout.LayoutBounds="21,10,5,10" Color="#F59E0B" CornerRadius="1.5"/>
                                    </AbsoluteLayout>
                                    <Label x:Name="lblStatFull" Text="57%" TextColor="#D97706" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Lấp đầy" TextColor="#64748B" FontSize="11" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" StrokeThickness="1.5" Stroke="#BFDBFE" Padding="0,14" BackgroundColor="White">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#3B82F6" Opacity="0.15" Radius="10" Offset="0,5"/></Border.Shadow>
                                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                    <Label Text="📍" FontSize="18" HorizontalOptions="Center" Margin="0,2,0,4"/>
                                    <Label x:Name="lblStatZone" Text="4" TextColor="#2563EB" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"/>
                                    <Label Text="Khu bãi" TextColor="#64748B" FontSize="11" HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" WidthRequest="26" HeightRequest="26">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B47D9" Offset="0"/>
                                            <GradientStop Color="#5868f0" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="1" FontSize="13" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Loại phương tiện"
                                       FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Border x:Name="borderXeDap" Grid.Column="0"
                                        StrokeThickness="2" Stroke="#3B47D9"
                                        BackgroundColor="#EEF0FF" Padding="14">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.Shadow><Shadow Brush="#3B47D9" Opacity="0.18" Radius="10" Offset="0,4"/></Border.Shadow>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnXeDapClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                        <Label Text="🚲" FontSize="28" HorizontalOptions="Center"/>
                                        <Label x:Name="lblXeDapText" Text="Xe đạp" FontSize="13" FontAttributes="Bold"
                                               TextColor="#3B47D9" HorizontalOptions="Center"/>
                                        <Border BackgroundColor="#DBEAFE" StrokeThickness="0" Padding="8,3">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                            <Label Text="3.000đ / 12h" FontSize="10" TextColor="#1D4ED8" HorizontalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="borderXeMay" Grid.Column="1"
                                        StrokeThickness="1.5" Stroke="#E2E8F0"
                                        BackgroundColor="White" Padding="14">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnXeMayClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="6">
                                        <Label Text="🛵" FontSize="28" HorizontalOptions="Center"/>
                                        <Label x:Name="lblXeMayText" Text="Xe máy" FontSize="13" FontAttributes="Bold"
                                               TextColor="#94A3B8" HorizontalOptions="Center"/>
                                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0" Padding="8,3">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                                            <Label Text="5.000đ / 12h" FontSize="10" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="0" WidthRequest="26" HeightRequest="26">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#059669" Offset="0"/>
                                            <GradientStop Color="#10B981" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Label Text="2" FontSize="13" FontAttributes="Bold" TextColor="White"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Chọn khu bãi"
                                       FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E" VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                <Border x:Name="borderZoneA" Grid.Row="0" Grid.Column="0" BackgroundColor="White" StrokeThickness="1.5" Stroke="#E2E8F0" Padding="14,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoneAClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label x:Name="lblTitleZoneA" Text="Khu A" FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E"/>
                                            <Border Grid.Column="1" BackgroundColor="#E8FDF4" StrokeThickness="1" Stroke="#4AE8A0" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                                <Label x:Name="lblBadgeA" Text="Còn chỗ" FontSize="10" FontAttributes="Bold" TextColor="#059669"/>
                                            </Border>
                                        </Grid>
                                        <Label x:Name="lblSlotA" Text="80 / 100 chỗ trống" FontSize="11" TextColor="#64748B"/>
                                        <Border x:Name="barA" BackgroundColor="#10B981" StrokeThickness="0" HeightRequest="5" HorizontalOptions="Start" WidthRequest="60">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="borderZoneB" Grid.Row="0" Grid.Column="1" BackgroundColor="White" StrokeThickness="1.5" Stroke="#E2E8F0" Padding="14,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoneBClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label x:Name="lblTitleZoneB" Text="Khu B" FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E"/>
                                            <Border Grid.Column="1" BackgroundColor="#E8FDF4" StrokeThickness="1" Stroke="#4AE8A0" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                                <Label x:Name="lblBadgeB" Text="Còn chỗ" FontSize="10" FontAttributes="Bold" TextColor="#059669"/>
                                            </Border>
                                        </Grid>
                                        <Label x:Name="lblSlotB" Text="4 / 50 chỗ trống" FontSize="11" TextColor="#64748B"/>
                                        <Border x:Name="barB" BackgroundColor="#10B981" StrokeThickness="0" HeightRequest="5" HorizontalOptions="Start" WidthRequest="60">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="borderZoneC" Grid.Row="1" Grid.Column="0" BackgroundColor="White" StrokeThickness="1.5" Stroke="#FDE68A" Padding="14,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoneCClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label x:Name="lblTitleZoneC" Text="Khu C" FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E"/>
                                            <Border Grid.Column="1" BackgroundColor="#FFF8E1" StrokeThickness="1" Stroke="#FFD700" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                                <Label x:Name="lblBadgeC" Text="Sắp đầy" FontSize="10" FontAttributes="Bold" TextColor="#D97706"/>
                                            </Border>
                                        </Grid>
                                        <Label x:Name="lblSlotC" Text="2 / 60 chỗ trống" FontSize="11" TextColor="#64748B"/>
                                        <Border x:Name="barC" BackgroundColor="#F59E0B" StrokeThickness="0" HeightRequest="5" HorizontalOptions="Start" WidthRequest="60">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                                <Border x:Name="borderZoneD" Grid.Row="1" Grid.Column="1" BackgroundColor="White" StrokeThickness="1.5" Stroke="#E2E8F0" Padding="14,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnZoneDClicked"/></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label x:Name="lblTitleZoneD" Text="Khu D" FontSize="14" FontAttributes="Bold" TextColor="#1A1A6E"/>
                                            <Border Grid.Column="1" BackgroundColor="#E8FDF4" StrokeThickness="1" Stroke="#4AE8A0" Padding="6,2">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                                <Label x:Name="lblBadgeD" Text="Còn chỗ" FontSize="10" FontAttributes="Bold" TextColor="#059669"/>
                                            </Border>
                                        </Grid>
                                        <Label x:Name="lblSlotD" Text="43 / 80 chỗ trống" FontSize="11" TextColor="#64748B"/>
                                        <Border x:Name="barD" BackgroundColor="#10B981" StrokeThickness="0" HeightRequest="5" HorizontalOptions="Start" WidthRequest="60">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="3"/></Border.StrokeShape>
