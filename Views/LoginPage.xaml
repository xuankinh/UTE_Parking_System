<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UTE_Parking_Project.Views.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#f0f4ff">

    <Grid>
        <!-- Background trắng xanh nhạt gradient -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#e8ecff" Offset="0.0"/>
                    <GradientStop Color="#f5f7ff" Offset="0.5"/>
                    <GradientStop Color="#eef1ff" Offset="1.0"/>
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <!-- Top blue accent blob -->
        <BoxView CornerRadius="300"
                 WidthRequest="420" HeightRequest="380"
                 HorizontalOptions="Center" VerticalOptions="Start"
                 TranslationY="-160">
            <BoxView.Background>
                <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                    <GradientStop Color="#3B47D9" Offset="0.0"/>
                    <GradientStop Color="#5868f0" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1.0"/>
                </RadialGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView VerticalOptions="Fill">
            <VerticalStackLayout Padding="28,0,28,40" Spacing="0">

                <!-- LOGO AREA -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,52,0,40">
                    <Grid HorizontalOptions="Center" WidthRequest="90" HeightRequest="90">
                        <Ellipse WidthRequest="90" HeightRequest="90"
                                 Stroke="#44ffffff" StrokeThickness="1"
                                 HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border WidthRequest="80" HeightRequest="80"
                                BackgroundColor="#1Affffff"
                                Stroke="#88ffffff" StrokeThickness="1.5"
                                HorizontalOptions="Center" VerticalOptions="Center">
                            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#ffffff" Opacity="0.3" Radius="12" Offset="0,0"/>
                            </Border.Shadow>
                            <AbsoluteLayout WidthRequest="50" HeightRequest="44"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                <Ellipse AbsoluteLayout.LayoutBounds="0,17,19,19" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                                <Ellipse AbsoluteLayout.LayoutBounds="31,17,19,19" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="9" Y1="26" X2="20" Y2="9" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="20" Y1="9" X2="20" Y2="18" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="20" Y1="18" X2="9" Y2="26" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="20" Y1="9" X2="40" Y2="18" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="20" Y1="18" X2="40" Y2="26" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="40" Y1="14" X2="40" Y2="26" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="37" Y1="14" X2="44" Y2="14" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="20" Y1="9" X2="17" Y2="5" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"/>
                                <Line AbsoluteLayout.LayoutBounds="0,0,50,44" X1="14" Y1="4" X2="21" Y2="4" Stroke="White" StrokeThickness="2.2" StrokeLineCap="Round"/>
                                <Ellipse AbsoluteLayout.LayoutBounds="35,0,7,7" Fill="White"/>
                            </AbsoluteLayout>
                        </Border>
                    </Grid>

                    <Label Text="UTE PARKING"
                           TextColor="White" FontSize="14"
                           HorizontalTextAlignment="Center" CharacterSpacing="4"/>
                </VerticalStackLayout>

                <!-- FORM CARD — nhỏ gọn, trắng, shadow xanh -->
                <Border BackgroundColor="White"
                        Stroke="#e0e4ff"
                        StrokeThickness="1.5"
                        Padding="26,28,26,24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#3B47D9" Opacity="0.18" Radius="24" Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- Login title -->
                        <Label Text="Login"
                               TextColor="#1a1f6e" FontSize="24" FontAttributes="Bold"
                               HorizontalTextAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Tên đăng nhập -->
                        <VerticalStackLayout Spacing="0" Margin="0,0,0,20">
                            <Label Text="Tên đăng nhập"
                                   TextColor="#3a4080" FontSize="13" FontAttributes="Bold"
                                   Margin="2,0,0,8"/>
                            <Border BackgroundColor="#f4f6ff"
                                    Stroke="#d0d5ff" StrokeThickness="1"
                                    HeightRequest="48" Padding="14,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Entry x:Name="txtUsername"
                                       Placeholder="Nhập MSSV / ID"
                                       PlaceholderColor="#aab0cc"
                                       TextColor="#1a1f6e" FontSize="14"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Mật khẩu -->
                        <VerticalStackLayout Spacing="0" Margin="0,0,0,28">
                            <Label Text="Mật khẩu"
                                   TextColor="#3a4080" FontSize="13" FontAttributes="Bold"
                                   Margin="2,0,0,8"/>
                            <Border BackgroundColor="#f4f6ff"
                                    Stroke="#d0d5ff" StrokeThickness="1"
                                    HeightRequest="48" Padding="14,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Entry x:Name="txtPassword"
                                       Placeholder="••••••••"
                                       IsPassword="True"
                                       PlaceholderColor="#aab0cc"
                                       TextColor="#1a1f6e" FontSize="14"
                                       VerticalOptions="Center"
                                       BackgroundColor="Transparent"/>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Đăng nhập button -->
                        <Button x:Name="btnLogin"
                                Text="Đăng nhập"
                                TextColor="White" FontAttributes="Bold" FontSize="16"
                                HeightRequest="52" CornerRadius="26"
                                Margin="0,0,0,16"
                                Clicked="OnLoginClicked">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3B47D9" Offset="0.0"/>
                                    <GradientStop Color="#6272f5" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <Button.Shadow>
                                <Shadow Brush="#3B47D9" Opacity="0.4" Radius="12" Offset="0,5"/>
                            </Button.Shadow>
                        </Button>

                        <!-- Liên hệ CTSV -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                            <Label Text="Chưa có tài khoản?"
                                   TextColor="#7880aa" FontSize="12" VerticalOptions="Center"/>
                            <Label Text="Liên hệ CTSV"
                                   TextColor="#3B47D9" FontAttributes="Bold"
                                   FontSize="12" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLienHeWebClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Dots -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,28,0,0">
                    <BoxView WidthRequest="20" HeightRequest="5" Color="#3B47D9" CornerRadius="3"/>
                    <BoxView WidthRequest="5" HeightRequest="5" Color="#c0c5e8" CornerRadius="3"/>
                    <BoxView WidthRequest="5" HeightRequest="5" Color="#c0c5e8" CornerRadius="3"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
